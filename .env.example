# Copy to .env and fill in. Nothing here has a safe production default.

# --- required in production -------------------------------------------------
# Used to hash phone numbers and handles before they touch the database.
# Rotating this makes existing consent receipts unverifiable (by design).
TANDEM_PEPPER=

# Where the API is reachable by browsers. OAuth redirect URIs default to this.
TANDEM_PUBLIC_URL=http://127.0.0.1:8080

# --- delivery ---------------------------------------------------------------
# Any endpoint that accepts POST {"to":"+1...","body":"..."}.
# Without it, verification codes are only logged.
TANDEM_SMS_WEBHOOK=

# --- services ---------------------------------------------------------------
PORT=8080
HOST=127.0.0.1
MATCHER_URL=http://127.0.0.1:8081
MATCHER_PORT=8081
TANDEM_DB=data/tandem.db

# --- limits -----------------------------------------------------------------
TANDEM_OTP_TTL_SECONDS=600
TANDEM_OTP_MAX_ATTEMPTS=5
TANDEM_OTP_MAX_PER_HOUR=5
TANDEM_PROOF_TTL_SECONDS=86400

# --- social linking (all optional) -----------------------------------------
# Discord: https://discord.com/developers/applications
TANDEM_DISCORD_CLIENT_ID=
TANDEM_DISCORD_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/apps
TANDEM_FACEBOOK_APP_ID=
TANDEM_FACEBOOK_APP_SECRET=

# --- scout ------------------------------------------------------------------
# Reddit stays disabled unless you have completed its OAuth + API terms work.
# TANDEM_SCOUT_ENABLE=reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Raises GitHub search rate limits.
GITHUB_TOKEN=
